int	iKeyID

float fPosX
float fPosY

begin Function {iKeyID}

	if eval MenuMode || (Goo1.AuxVarGetFlt "*PipMap_Init" 0 == 0 && Goo1.AuxTimerTimeLeft "*Minimap_Key" == -1) || (Goo1.AuxVarGetFlt "*PipMap_Init" 0 && iKeyID == Goo1.AuxVarGetFlt "*Minimap_Key" 0)
		return
	endif

	if eval GetUIFloatAlt "HUDMainMenu\ModernMinimap\_MapMode"
		SetUIFloatAlt "HUDMainMenu\ModernMinimap\_MapMode" 0
		SetUIStringAlt "HUDMainMenu\ModernMinimap\InfoText\string" "Map: World"
		if eval Goo1.AuxVarGetFlt "*PipMap_Init" 0 && ModelHasBlock Player "TabKnob"
			Player.SetNifRot "TabKnob" 0 0 0 2 2
		endif
		Call (CompileScript "ModernMinimap\WorldMap\MainLoop.gek")
	else
		SetUIFloatAlt "HUDMainMenu\ModernMinimap\_MapMode" 1
		SetUIStringAlt "HUDMainMenu\ModernMinimap\InfoText\string" "Map: Local"
		if eval Goo1.AuxVarGetFlt "*PipMap_Init" 0 && ModelHasBlock Player "TabKnob"
			Player.SetNifRot "TabKnob" 0 0 28.65 2 2
		endif
		Call (CompileScript (Goo1.AuxVarGetStr "*Minimap_Script" 0))
	endif

	if eval Goo1.AuxVarGetFlt "*PipMap_Init" 0
		Player.PlaySound3D UIPipBoyTab
		Player.PlaySound3D NPCIdlePipBoyStatic
	endif

	UnloadUIComponent "HUDMainMenu\ModernMinimap\PlayerPath"
	AddTileFromTemplate "HUDMainMenu\ModernMinimap|Minimap_Path_Rect|PlayerPath"

	SetUIFloatGradual "HUDMainMenu\ModernMinimap\InfoText\alpha" 400 0 0.5

	Goo1.AuxTimerStop "*Minimap_Key"

end